{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rarry",
  "version": "1.7.0",
  "identifier": "link.rarry.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/editor.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rarry",
        "width": 800,
        "height": 600,
        "url": "editor.html",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NjJCNDVERUFGNkQzRTIKUldUaTAvYnFYYlJpdGozUEhMZG1RUmFOMXduMWhGNWlDdVZMVk5pUEhSRlF1NTdPSkcwRDlhWm4K",
      "endpoints": [
        "https://github.com/Rarry-Blocks/website/releases/latest/download/latest.json"
      ]
    }
  }
}
